# QueueCare — server environment
# Copy to .env and fill in your values. Never commit a real .env.
#   cp .env.example .env

# Port the API + Socket.IO server listens on
PORT=5000

# development | production (cookies become `secure` in production — serve over HTTPS)
NODE_ENV=development

# MongoDB connection string (local mongod or Atlas)
MONGO_URI=mongodb://localhost:27017/queuecare

# Secret used to sign the httpOnly JWT cookie — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# JWT lifetime (matches the 8h cookie max-age)
JWT_EXPIRE=8h

# Origin of the React SPA (Vite dev server). The cookie is only sent to this origin.
CLIENT_URL=http://localhost:5173
